# Committed on purpose — see .gitignore. Every value here is NEXT_PUBLIC_*,
# meaning it ships inside the static bundle and is readable by anyone who
# views source regardless of where it's stored. That's what makes it safe
# to check in: CI (`next build` in .github/workflows/deploy.yml) needs these
# to produce the same build that's already live, without duplicating them as
# GitHub Actions secrets. RLS is what actually protects the data (PLAN.md
# §5.1) — see .env.local's own comment for the same note.

NEXT_PUBLIC_SUPABASE_URL=https://gxzxlcopknxzcfpphyyv.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_CyflqsDU3hHK2i-wzVrYnw_PvjWPnnI

NEXT_PUBLIC_SITE_URL=https://synchromediallc.com
NEXT_PUBLIC_UPLOAD_API_URL=https://synchromediallc.com/api

NEXT_PUBLIC_TURNSTILE_SITE_KEY=
