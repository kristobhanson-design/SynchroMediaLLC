# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except .env.production: every value in it is NEXT_PUBLIC_* and ships
# inside the static bundle anyway (readable by anyone who views source), so
# committing it lets CI build without duplicating these as repo secrets.
!.env.production

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Static export output
out/

# Local env
.env.local

# Source photography — masters stay in Blake's own backup, not the repo
Media/
